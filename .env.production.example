# DOCTORIN — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production on production deployment host

APP_NAME="DoctorIn"
APP_ENV="production"
DEBUG=false
API_VERSION="v1"

# Domain & Security
DOMAIN_NAME="doctorin.app"
CORS_ORIGINS='["https://doctorin.app", "https://www.doctorin.app"]'
CORS_ALLOW_CREDENTIALS=true

# Database (PostgreSQL 16)
POSTGRES_USER="doctorin_admin"
POSTGRES_PASSWORD="GenerateStrongPostgresPasswordHere!"
POSTGRES_DB="doctorin_db"
DATABASE_URL="postgresql+asyncpg://doctorin_admin:GenerateStrongPostgresPasswordHere!@postgres:5432/doctorin_db"

# Cache & Rate Limiting (Redis 7)
REDIS_PASSWORD="GenerateStrongRedisPasswordHere!"
REDIS_URL="redis://:GenerateStrongRedisPasswordHere!@redis:6379/0"

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
JWT_SECRET_KEY="GenerateSecretKey32BytesHexMinimumHere"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_HMAC_SECRET="GenerateHmacSecret32BytesHexMinimumHere"

# S3 / Object Storage for Verification Documents & Media
STORAGE_PROVIDER="s3"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="wJalr..."
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="doctorin-production-documents"

# SMS OTP Provider (Twilio or MSG91)
SMS_PROVIDER="msg91"
SMS_API_KEY="YourMsg91AuthKey"
SMS_SENDER_ID="DOCINR"
