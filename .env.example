# ================================================
# DoctorIn — Environment Variables Example
# ================================================
# Copy this file to .env or backend/.env and fill in your values.
# NEVER commit the real .env file to version control.
# ================================================

# ---- Application ----
APP_NAME=DoctorIn
APP_ENV=development
DEBUG=true
API_VERSION=v1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Database (PostgreSQL / SQLite) ----
# Local development fallback: sqlite+aiosqlite:///./doctorin_dev.db
# Production PostgreSQL:
POSTGRES_USER=doctorin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=doctorin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis Cache & Rate Limiting ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- JWT Authentication ----
JWT_SECRET=replace-with-a-strong-random-secret-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret-min-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- OTP & Verification ----
# Options: development (prints to terminal), resend, smtp, sms
OTP_PROVIDER=development
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SECRET=
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Email Delivery ----
# Options: development, smtp, resend
EMAIL_PROVIDER=development
EMAIL_FROM=DoctorIn <noreply@doctorin.com>

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Resend Configuration (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ---- S3-Compatible Object Storage ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=doctorin
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
CORS_ALLOW_CREDENTIALS=true

# ---- Frontend (Next.js public environment variables) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=DoctorIn
NEXT_PUBLIC_APP_TAGLINE=Connect with Verified Medical Professionals.
