# ==================================================
# DoctorIn Backend — Environment Variables Example
# ==================================================

# Core Application Settings
APP_NAME=DoctorIn
APP_ENV=development
DEBUG=True
API_VERSION=v1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL with SQLite Fallback)
POSTGRES_USER=doctorin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=doctorin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./doctorin_dev.db
DATABASE_URL_SYNC=postgresql://doctorin:your_secure_db_password@localhost:5432/doctorin

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# JWT Security Credentials
JWT_SECRET=change-this-to-a-secure-random-32-character-secret-key
JWT_REFRESH_SECRET=change-this-to-another-secure-random-32-character-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# OTP Provider Configuration
# Options: development, resend, sms, email
OTP_PROVIDER=development
OTP_EXPIRY_MINUTES=5
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email Delivery Configuration
# Options: development, smtp, resend
EMAIL_PROVIDER=development
EMAIL_FROM=DoctorIn <noreply@doctorin.com>

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=

# Resend API (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# S3 File Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=doctorin
S3_REGION=us-east-1
S3_USE_SSL=False

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
